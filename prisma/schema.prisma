// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Itinerary {
  id        String          @id @default(cuid())
  title     String          @default("Untitled Trip")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     ItineraryItem[]
  messages  ChatMessage[]

  @@index([userId])
}

model ItineraryItem {
  id          String    @id @default(cuid())
  name        String
  city        String
  location    String?
  date        String?
  startTime   String?
  endTime     String?
  latitude    Float?
  longitude   Float?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  itineraryId String
  itinerary   Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)

  @@index([itineraryId])
  @@index([date])
}

model ChatMessage {
  id          String    @id @default(cuid())
  role        String
  content     String
  createdAt   DateTime  @default(now())
  itineraryId String
  itinerary   Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)

  @@index([itineraryId])
  @@index([createdAt])
}

// NoteFolder model - organises notes into nested, user-created folders (unlimited depth)
model NoteFolder {
  id             String       @id @default(cuid())
  name           String
  order          Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentFolderId String?
  parentFolder   NoteFolder?  @relation("NoteFolderHierarchy", fields: [parentFolderId], references: [id], onDelete: Cascade)
  childFolders   NoteFolder[] @relation("NoteFolderHierarchy")
  notes          Note[]

  @@index([userId])
  @@index([parentFolderId])
}

// Note model - a single Markdown document, optionally stored inside a folder
model Note {
  id        String      @id @default(cuid())
  title     String
  content   String      @db.Text
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  folderId  String?
  folder    NoteFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([folderId])
}

// User model - stores user information
model User {
  id            String       @id @default(cuid())
  name          String?
  email         String       @unique
  emailVerified DateTime?
  image         String?
  password      String? // For credentials auth
  role          String       @default("user")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  itineraries   Itinerary[]
  notes         Note[]
  noteFolders   NoteFolder[]

  // NextAuth adapter fields
  accounts Account[]
  sessions Session[]

  @@index([email])
}

// NextAuth adapter models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
